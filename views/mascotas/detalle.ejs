<article class="detalle">
    <img src="<%= mascota.imagen %>" alt="" width="400" height="400">

    <p class="etiqueta"><%= mascota.nombre %></p>
    
    <h2>Especie: <%= mascota.especie %></h2>
            
    <p class="precio">Edad: <%= mascota.edad%></p>

    <p>Descripción: <%= mascota.descripcion %></p>

    <p>Estado: <%= mascota.estado %></p>

    <a href="/mascotas">Volver al catálogo</a>
</article>