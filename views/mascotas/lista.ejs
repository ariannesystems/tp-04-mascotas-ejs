<header class="cabecera-pagina">
    <div>
        <p class="etiqueta">CATÁLOGO</p>
        <h1><%= titulo %></h1>
    </div>
    <a class="boton" href="/productos/nuevo">Agregar producto</a>
 </header>

<% if (mascotas.length === 0) { %>
 <p>No hay mascotas para mostrar.</p>
<% } else { %>
 <section class="grilla" aria-label="Productos disponibles">
    <% mascotas.forEach((mascota) => { %>
    <article class="tarjeta">
        <p class="etiqueta"><%= mascota.nombre %></p>
        <h2><%= mascota.especie %></h2>
        <p class="precio">$<%= mascota.edad.toLocaleString("es-AR") %></p>
        <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
    </article>
    <% }) %>
 </section>
<% } %>